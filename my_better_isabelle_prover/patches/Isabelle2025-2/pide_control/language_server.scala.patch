+          } yield HTML.link(uri.toString + "#" + def_line, body)
+      }
+    val elements = Browser_Info.extra_elements.copy(entity = Markup.Elements.full)
+    HTML.source(node_context.make_html(elements, Pretty.separate(messages))).toString
+  }
